# BookStud.io Production Environment Configuration
# ======================================
# This file contains all environment variables required for production deployment
# Create a copy of this file named .env and fill in the values before deployment

# Application Settings
# -------------------
NODE_ENV=production
PORT=5000
VERSION=1.5.2  # Used for Docker image tagging
HOST=0.0.0.0   # Bind to all network interfaces

# Session Security
# ---------------
# Generate a strong random string (at least 32 chars) using: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_secure_random_string

# Cookie Settings (for HTTPS deployment)
# -------------
COOKIE_SECURE=true      # Set to true for HTTPS, false for HTTP
COOKIE_SAME_SITE=lax    # Options: strict, lax, none

# Timezone Configuration (CRITICAL)
# ---------------------
# Do not change unless facility location changes
TZ=America/Chicago
FACILITY_TIMEZONE=America/Chicago
VITE_FACILITY_TIMEZONE=America/Chicago

# Database Configuration
# ---------------------
PGUSER=postgres
PGPASSWORD=your_secure_database_password_here
PGDATABASE=bookstudio
PGPORT=5432
PGHOST=db
# Database connection URL (PostgreSQL)
DATABASE_URL=postgres://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# Email Notifications (SendGrid)
# ----------------------------
# Required for sending booking confirmations, password resets, and user invitations
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_VERIFIED_SENDER=support@bookstud.io  # Must be verified in SendGrid

# Application Domain (Production)
# ------------------------------
# Set this to your production domain for correct email links (NO PORTS!)
# Example: https://bookstudio.yourdomain.com or https://your-app.herokuapp.com
# IMPORTANT: Do NOT include ports - production domains should be clean
APP_DOMAIN=https://your-production-domain.com

# Site Manager Notifications
# -------------------------
# Email address for site manager notifications on all booking activities
SITE_MANAGER_EMAIL=obedtest@tbn.tv

# Weather Integration (OpenWeatherMap)
# -----------------------------------
# Required for signage page weather display and forecasts
# Get your free API key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Weather Location Configuration
# -----------------------------
# REQUIRED: Configure location for weather data for your facility
# You can use city name or coordinates for more precise location
VITE_WEATHER_LOCATION=YourCity,State,US
# Alternative using coordinates (more precise):
VITE_WEATHER_LAT=your_latitude_here
VITE_WEATHER_LON=your_longitude_here

# User Roles Configuration
# ----------------------
# Enable site manager role for more granular permissions
SUPPORT_SITE_MANAGER_ROLE=true

# Docker-specific Configuration
# --------------------------
# These values are used by the Docker deployment
RUNNING_IN_DOCKER=true

# Production Deployment Options
# --------------------------
# When using Nginx Proxy Manager externally, you only need to ensure:
# 1. PORT is set correctly (default: 5000)
# 2. Your Nginx Proxy Manager is configured to proxy to your Docker host IP:PORT
# 3. SSL termination is handled by Nginx Proxy Manager

# Audit Logging Configuration (v1.5.2)
# ------------------------------------
# Audit logging is enabled by default and requires no additional configuration
# - All user actions, system changes, and admin operations are automatically tracked
# - 90-day retention policy with automatic cleanup
# - Access restricted to admin and site_manager roles only
# - Timestamps displayed in facility timezone (VITE_FACILITY_TIMEZONE)

# Backup Configuration
# ------------------
# Uncomment and configure for automated database backups
# BACKUP_ENABLED=true
# BACKUP_INTERVAL=86400  # Daily backups (in seconds)
# BACKUP_RETENTION=7     # Keep backups for 7 days
# Note: Backups now include audit logs by default - use selective backup if needed