# Environment variables for BookStud.io

# Database settings
# This is the URL that will be used by the application to connect to PostgreSQL
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@db:5432/bookstudio

# SendGrid API key for email functionality
# If not provided, email notifications will be disabled
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Application configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Mark as running in Docker
IS_DOCKER=true