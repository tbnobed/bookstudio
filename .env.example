# Application settings
NODE_ENV=production
PORT=5000
# Session configuration
SESSION_SECRET=change_this_to_a_secure_random_string
# Cookie settings for authentication (important for Docker deployment)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Database settings - Docker will use these defaults automatically
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bookstudio
PGPORT=5432
PGHOST=db
# Ensure this URL format is postgres:// for Docker deployment
DATABASE_URL=postgres://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# Email notifications (required for sending booking confirmations)
# Get a free API key from SendGrid: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Docker configuration - Do not change these values
HOST=0.0.0.0
RUNNING_IN_DOCKER=true