# Application settings
NODE_ENV=production
PORT=5000
# A random string will be generated if not provided
SESSION_SECRET=change_this_to_a_secure_random_string

# Database settings
# These default values will work with docker-compose out of the box
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bookstudio
PGPORT=5432
# Use 'db' for Docker, 'localhost' for local development
PGHOST=db
# This will be automatically constructed from the variables above
DATABASE_URL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# Email service (required for sending notifications)
# A placeholder will be used if not provided, but email sending will fail
SENDGRID_API_KEY=your_sendgrid_api_key_here

# For production deployment
HOST=0.0.0.0
RUNNING_IN_DOCKER=true