# BookStud.io - Docker Environment Example
# Copy this file to .env and update values before deployment

# Application Settings
NODE_ENV=production
PORT=5000
SESSION_SECRET=replace_with_strong_random_value

# PostgreSQL Database Settings
POSTGRES_USER=bookstudio
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=bookstudio
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Email Notifications (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@bookstud.io
SENDGRID_FROM_NAME=BookStud.io

# Security (optional)
SECURITY_ALLOWED_ORIGINS=https://yourdomain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Monitoring (optional)
ENABLE_REQUEST_LOGGING=true 
REQUEST_LOG_FORMAT=combined

# Redis Session Store (optional - for better session handling at scale)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# USE_REDIS_SESSIONS=false